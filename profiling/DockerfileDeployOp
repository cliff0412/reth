FROM golang:1.21-bullseye AS go-builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    git \
    make \
    jq \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install Foundry for contract deployment
RUN curl -L https://foundry.paradigm.xyz | bash
RUN /root/.foundry/bin/foundryup
ENV PATH="/root/.foundry/bin:${PATH}"

# Install Node.js for some scripts
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash -
RUN apt-get install -y nodejs


# Install just (required for optimism build)
RUN curl --proto '=https' --tlsv1.2 -sSf https://just.systems/install.sh | bash -s -- --to /usr/local/bin


# Clone and build optimism
WORKDIR /app
RUN git clone https://github.com/ethereum-optimism/optimism.git
WORKDIR /app/optimism
RUN git checkout v1.9.3
RUN make build

# # Create build directory
# # RUN mkdir -p /app/optimism/build

WORKDIR /app

# Create deployment config
RUN mkdir -p optimism/packages/contracts-bedrock/deploy-config
COPY ./profiling/deploy-config/devnetL1.json optimism/packages/contracts-bedrock/deploy-config
COPY ./profiling/deploy-op.sh /app/deploy-op.sh
RUN chmod +x /app/deploy-op.sh
